# Copy to `.env` or `.env.local` (gitignored).

# App shell theme — `RELEASE` (default) or `DEBUG` (high-visibility layout boundaries).
APP_THEME=RELEASE

# Photography — Lightroom share thumbnails (public Adobe web client key).
NEXT_PUBLIC_ADOBE_LIGHTROOM_WEB_CLIENT_KEY=

# Photography — album passwords and share URLs (JSON, server-only). Keys match `id` in
# `components/photography/config/photographyAlbumEntries.ts`.
PHOTOGRAPHY_GALLERY_PASSWORDS=
PHOTOGRAPHY_GALLERY_SHARE_URLS=

# Burke Location Finder — Google Geocoding API key (server-only).
BURKE_GOOGLE_MAPS_API_KEY=

# Burke Location Finder — password gate (server-only). Both required to enable the gate.
BURKE_LOCATION_FINDER_PASSWORD=
BURKE_LOCATION_FINDER_SECRET=

# Scheduler Calendar — Google OAuth (server-only). Register redirect URI:
# http://localhost:3000/api/scheduler/calendar/callback (and production origin).
SCHEDULER_GOOGLE_OAUTH_CLIENT_ID=
SCHEDULER_GOOGLE_OAUTH_CLIENT_SECRET=
SCHEDULER_CALENDAR_SESSION_SECRET=

# WoW — Battle.net API (server-only). Optional; roster pages work with reduced detail without these.
BATTLENET_CLIENT_ID=
BATTLENET_CLIENT_SECRET=
